# Шаблон конфигурации. Скопируйте в .env и заполните значения.
#
#   cp .env.example .env
#
# Файл .env добавлен в .gitignore и в репозиторий попадать не должен.

# --- Шлюз моделей (OpenAI-совместимый) ---
# Любой провайдер с /v1/chat/completions: opencode.ai/zen, DeepSeek, OpenAI, Ollama.
OPENAI_API_BASE_URL=https://opencode.ai/zen/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Секрет сессий Open WebUI ---
# Сгенерируйте свой: openssl rand -hex 32
WEBUI_SECRET_KEY=

# --- Модель по умолчанию ---
# id пресета, который создаётся в Open WebUI (см. README, раздел «Пресет тьютора»)
DEFAULT_MODEL=naparnik-tutor

# --- Адрес приложения ---
# IP машины в домашней сети или DNS-имя, которое на неё указывает.
SITE_ADDRESS=192.168.1.100
WEBUI_PUBLIC_URL=https://192.168.1.100
# Порт прямого HTTP-доступа (резервный вход, без микрофона)
WEBUI_HTTP_PORT=3000

# --- Синтез речи ---
# Внутренний ключ между Open WebUI и naparnik-tts (любая строка)
TTS_API_KEY=naparnik-tts-local
# Голос: en-US-AriaNeural, en-US-JennyNeural, en-US-GuyNeural,
# en-GB-SoniaNeural, en-GB-RyanNeural
TTS_VOICE=en-US-AriaNeural
